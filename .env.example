# Token del panel /admin. OBLIGATORIO cambiarlo en produccion.
ADMIN_TOKEN=sensory-admin-dev

# Origenes del navegador permitidos por CORS (separados por coma).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
